#!/bin/bash

force=false
while getopts ":f" option; do
  case "$option" in
    f) force=true ;;
    *)
      echo "usage: git main [-f] [branch]" >&2
      exit 2
      ;;
  esac
done
shift $((OPTIND - 1))

if (( $# > 1 )); then
  echo "usage: git main [-f] [branch]" >&2
  exit 2
fi

main="$(git symbolic-ref --short refs/remotes/origin/HEAD)" || exit 1
main="${main#origin/}"
target="${1:-$main}"

# NUL-delimited porcelain preserves spaces, newlines, and backslashes in paths.
while IFS= read -r -d '' field; do
  case "$field" in
    'worktree '*) worktree="${field#worktree }" ;;
    "branch refs/heads/$target")
      if [[ "$(git symbolic-ref -q HEAD)" != "refs/heads/$target" ]]; then
        printf 'git-main: %s is already checked out in %s; updating it there.\n' "$target" "$worktree" >&2
        printf 'git-main: to enter that worktree, run: cd -- %q\n' "$worktree" >&2
      fi
      cd -- "$worktree" || exit 1
      break
      ;;
  esac
done < <(git worktree list --porcelain -z)

if ! git fetch; then
  echo "git-main: git fetch failed" >&2
  exit 1
fi

if ! $force &&
  [[ "$(git rev-parse "origin/$main")" != "$(git rev-parse HEAD)" ]] &&
  git merge-base --is-ancestor "origin/$main" HEAD; then
  echo "git-main: warning: HEAD contains commits that have not been pushed to origin/$main; use -f to discard them" >&2
  exit 1
fi

git checkout -B "$target" "origin/$main"
