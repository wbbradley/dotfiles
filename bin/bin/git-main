#!/bin/bash

force=false
while getopts ":f" option; do
  case "$option" in
    f) force=true ;;
    *)
      echo "usage: git main [-f] [branch]" >&2
      exit 2
      ;;
  esac
done
shift $((OPTIND - 1))

if (( $# > 1 )); then
  echo "usage: git main [-f] [branch]" >&2
  exit 2
fi

if ! git fetch; then
  echo "$0: git fetch failed" >&2
  exit 1
fi

main="$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')"
if ! $force &&
  [[ "$(git rev-parse "origin/$main")" != "$(git rev-parse HEAD)" ]] &&
  git merge-base --is-ancestor "origin/$main" HEAD; then
  echo "$0: warning: HEAD contains commits that have not been pushed to origin/$main; use -f to discard them" >&2
  exit 1
fi

if [[ -n "$1" ]] && [[ -n "$main" ]]; then
  git checkout -B "$1" "origin/$main"
else
  git checkout -B "$main" "origin/$main"
fi
