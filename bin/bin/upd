#!/usr/bin/env python3
"""upd: update local checkouts and rebuild installables.

Phases:
  1. Parallel per-repo: fetch, fast-forward pull, then push if clean & ahead.
     Dirty repos defer their push to phase 2.
  2. Serial dirty-handling: for each dirty repo, prompt to commit. On "y",
     stage everything, generate a commit message via Claude (falling back to
     Codex), and open the git commit editor (git commit -e -F <msg>). If both
     generators fail, the editor opens with a blank message. If the editor
     exits non-zero (e.g. `:cq` from vim), the commit is aborted and the repo
     is left dirty. On a successful commit, the repo is pushed afterward.
  3. Password store: fast-forward pull, then push local password changes.
  4. Parallel install: re-run install commands whose repo HEAD changed
     (or all of them with --force).
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import unicodedata
from collections import defaultdict, deque
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from typing import Optional

BOLD = "\033[1m"
RED = "\033[1;31m"
GREEN = "\033[1;32m"
YELLOW = "\033[1;33m"
CYAN = "\033[1;36m"
DIM = "\033[2m"
RESET = "\033[0m"

PREFIX_COLORS = [
    "\033[36m",  # cyan
    "\033[32m",  # green
    "\033[33m",  # yellow
    "\033[35m",  # magenta
    "\033[34m",  # blue
    "\033[31m",  # red
    "\033[96m",  # bright cyan
    "\033[92m",  # bright green
]

HOME = Path.home()

CARGO_INSTALL = ["cargo", "install", "--path", "."]
GO_INSTALL = ["go", "install"]

COMMIT_MESSAGE_PROMPT = (
    "Inspect the staged Git diff and generate a concise Conventional Commits "
    "message. Start the subject with one of build, chore, ci, docs, feat, fix, "
    "perf, refactor, revert, style, or test, optionally followed by a scope. "
    "Output the commit message text only: no quotes, no markdown fences, no "
    "preamble, and no attributions. Include a body only when it adds important "
    "context."
)
CONVENTIONAL_SUBJECT_RE = re.compile(
    r"^(?:build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)"
    r"(?:\([^\r\n()]+\))?!?: \S"
)

# Every repo to keep up to date, mapped to its install command (None = no build
# step; the repo is only fetched/pulled/pushed).
REPOS: dict[Path, Optional[list[str]]] = {
    HOME / "wiki": None,
    HOME / "src/dotfiles": None,
    HOME / "src/pickls": None,
    HOME / "src/nvim-procman": None,
    HOME / "src/tree-sitter-procman": None,
    HOME / "src/jumplist.nvim": None,
    HOME / "src/agentic": [str(HOME / "src/agentic/install.sh")],
    HOME / "src/shellsafety": ["cabal", "install", "--overwrite-policy=always"],
    HOME / "src/tmux-agent": [str(HOME / "src/tmux-agent/bin/tmux-agent-setup")],
    HOME / "src/wt": CARGO_INSTALL,
    HOME / "src/scrapwatch": CARGO_INSTALL,
    HOME / "src/statusline": CARGO_INSTALL,
    HOME / "src/autorize": CARGO_INSTALL,
    HOME / "src/procman": CARGO_INSTALL,
    HOME / "src/hq": GO_INSTALL + ["./cmd/hq"],
    HOME / "src/rollup": CARGO_INSTALL,
    HOME / "src/git-stack": CARGO_INSTALL,
    HOME / "src/rtop": CARGO_INSTALL,
    HOME / "src/dangle": CARGO_INSTALL,
}

# These repos use their existing Git configuration and are never cloned.
OPTIONAL_REPOS = {HOME / "wiki"}

GITHUB_USER = "wbbradley"

DOTFILES_DIR = HOME / "src/dotfiles"
SELF_REL_PATH = "bin/bin/upd"  # path to this script within DOTFILES_DIR

_print_lock = threading.Lock()
_status: dict[str, str] = {}
_status_lock = threading.Lock()
_heads: dict[str, str] = {}
_heads_lock = threading.Lock()


# Child output is retained for diagnostics, never written over the live display.
ANSI_RE = re.compile(r"\x1b(?:\][^\x07\x1b]*(?:\x07|\x1b\\)|\[[0-?]*[ -/]*[@-~])")
_logs: dict[str, deque[str]] = defaultdict(lambda: deque(maxlen=80))
_display: Optional["Progress"] = None
_plain = False


def plain_text(text: str) -> str:
    text = ANSI_RE.sub("", text)
    return "".join(c for c in text if c.isprintable() or c == "\t").expandtabs(4)


def clip(text: str, columns: int) -> str:
    """Clip by terminal cells, including wide Unicode characters."""
    used = 0
    result = ""
    for char in text:
        size = 0 if unicodedata.combining(char) else (2 if unicodedata.east_asian_width(char) in "WF" else 1)
        if used + size > columns:
            return result[:-1] + "…" if result else ""
        result += char
        used += size
    return result


class Progress:
    """One terminal row per job, with bounded output retained for failures."""

    def __init__(self, title: str, names: list[str]):
        self.title = title
        self.rows = {name: {"state": "queued", "detail": "waiting", "start": 0.0, "end": 0.0}
                     for name in names}
        self.live = sys.stdout.isatty() and os.environ.get("TERM") != "dumb" and not _plain
        self.lock = threading.RLock()
        self.stop = threading.Event()
        self.thread: Optional[threading.Thread] = None
        self.drawn = 0
        self.tick = 0
        self.frame: list[str] = []
        self.size: Optional[os.terminal_size] = None

    def __enter__(self):
        global _display
        _display = self
        sys.stdout.write(f"\n{BOLD}{self.title}{RESET}\n")
        if self.live:
            sys.stdout.write("\033[?25l")
            self.render()
            self.thread = threading.Thread(target=self.animate, daemon=True)
            self.thread.start()
        sys.stdout.flush()
        return self

    def __exit__(self, *_):
        global _display
        self.stop.set()
        if self.thread:
            self.thread.join()
        try:
            if self.live:
                self.render(final=True)
        finally:
            _display = None
            if self.live:
                sys.stdout.write("\033[?25h")
                sys.stdout.flush()

    def animate(self):
        while not self.stop.wait(0.1):
            self.render()

    def start(self, name: str):
        with self.lock:
            self.rows[name].update(state="running", detail="starting", start=time.monotonic())

    def update(self, name: str, detail: str):
        with self.lock:
            if name in self.rows:
                self.rows[name]["detail"] = detail

    def finish(self, name: str):
        with self.lock:
            status = _status.get(name, "OK")
            self.rows[name].update(state=status, end=time.monotonic())
            if not self.live:
                sys.stdout.write(self.line(name, self.rows[name]) + "\n")
                sys.stdout.flush()

    def line(self, name: str, row: dict) -> str:
        state = row["state"]
        if state == "running":
            icon, color = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"[self.tick % 10], CYAN
            detail = row["detail"]
        elif state == "queued":
            icon, color, detail = "·", DIM, "waiting"
        else:
            color, failed = summary_color(state)
            icon = "✗" if failed else ("✓" if state in ("OK", "COMMITTED") else "–")
            detail = state
            if row["detail"] and row["detail"] != state:
                detail += " · " + row["detail"]
        elapsed = (row["end"] or time.monotonic()) - row["start"] if row["start"] else 0
        width = min(26, max(map(len, self.rows)))
        label = clip(name, width)
        text = f" {icon} {label:<{width}}  {elapsed:5.1f}s  {detail}"
        if self.live:
            text = clip(text, max(1, shutil.get_terminal_size().columns - 1))
        return f"{color}{text}{RESET}"

    def render(self, final: bool = False):
        with self.lock:
            size = shutil.get_terminal_size()
            # Keep the live area shorter than the screen so cursor-up never
            # targets rows that have already scrolled into terminal history.
            limit = max(1, size.lines - 4)
            items = list(self.rows.items())
            overflow = len(items) > limit and not final
            if overflow:
                items.sort(key=lambda item: item[1]["state"] != "running")
                items = items[:max(0, limit - 1)]
            frame = [self.line(name, row) for name, row in items]
            if overflow:
                frame.append(clip(f" … {len(self.rows) - len(items)} more jobs", size.columns - 1))
            output = ""
            if self.drawn:
                output += f"\033[{min(self.drawn, max(1, size.lines - 1))}A\r"
            if len(frame) == len(self.frame) and size == self.size:
                # Completed rows stay untouched while each active row advances.
                for previous, current in zip(self.frame, frame):
                    output += "\033[1B\r" if current == previous else f"\033[2K{current}\r\n"
            else:
                output += "\033[J" + "".join(line + "\n" for line in frame)
            sys.stdout.write(output)
            self.frame, self.size = frame, size
            self.drawn = len(frame)
            self.tick += 1
            sys.stdout.flush()


def run_job(name: str, fn, *args):
    """Surface worker exceptions as job failures and keep unrelated jobs going."""
    if _display:
        _display.start(name)
    try:
        return fn(*args)
    except Exception as err:
        emit(name, RED, 0, f"{type(err).__name__}: {err}")
        set_status(name, "FAIL (exception)")
        return None
    finally:
        if _display:
            _display.finish(name)


def failure_summary() -> int:
    failures = [(name, status) for name, status in _status.items()
                if status.startswith(("FAIL", "WARN"))]
    sys.stdout.write(f"\n{BOLD}Finished{RESET} · {len(_status)} jobs · {len(failures)} issues\n")
    for name, status in failures:
        color, _ = summary_color(status)
        sys.stdout.write(f"\n{color}── {name}: {status} ──{RESET}\n")
        sys.stdout.write(f"{DIM}Recent output (up to 80 lines):{RESET}\n")
        for line in _logs[name]:
            sys.stdout.write(f"  {line}\n")
    sys.stdout.flush()
    return int(any(status.startswith("FAIL") for _, status in failures))


def set_status(name: str, val: str) -> None:
    with _status_lock:
        _status[name] = val


def set_head(dir: Path, val: str) -> None:
    with _heads_lock:
        _heads[str(dir)] = val


def get_head(dir: Path) -> Optional[str]:
    with _heads_lock:
        return _heads.get(str(dir))


def emit(name: str, color: str, width: int, text: str) -> None:
    lines = [plain_text(line) for line in text.splitlines()] or [""]
    with _print_lock:
        _logs[name].extend(lines)
        if _display:
            _display.update(name, lines[-1])
        else:
            for line in lines:
                sys.stdout.write(f"{color}{name:<{width}}{RESET} | {line}\n")
            sys.stdout.flush()


def git(dir: Path, *args: str) -> tuple[int, str, str]:
    r = subprocess.run(
        ["git", "-C", str(dir), *args],
        capture_output=True, text=True,
    )
    return r.returncode, r.stdout, r.stderr


def git_q(dir: Path, *args: str) -> str:
    rc, out, _ = git(dir, *args)
    return out.strip() if rc == 0 else ""


def stream(name: str, color: str, width: int, cmd: list[str],
           cwd: Optional[Path] = None) -> int:
    with subprocess.Popen(
        cmd, cwd=cwd, stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT, text=True, errors="replace",
    ) as proc:
        assert proc.stdout is not None
        for line in proc.stdout:
            emit(name, color, width, line.rstrip("\n"))
        return proc.wait()


def clone_missing(dir: Path, color: str, width: int, dry_run: bool) -> bool:
    name = dir.name
    url = f"git@github.com:{GITHUB_USER}/{name}.git"
    emit(name, color, width, f"{CYAN}cloning{RESET} {url} -> {dir}")
    if dry_run:
        emit(name, color, width, f"{DIM}dry-run:{RESET} git clone {url} {dir}")
        return True
    dir.parent.mkdir(parents=True, exist_ok=True)
    return stream(name, color, width, ["git", "clone", url, str(dir)]) == 0


def process_repo(dir: Path, color: str, width: int,
                 dry_run: bool) -> Optional[Path]:
    """Run fetch/pull and (when clean) push. Return dir if dirty, else None."""
    name = dir.name

    def e(s: str) -> None:
        emit(name, color, width, s)

    e(f"{CYAN}==>{RESET} {DIM}{dir}{RESET}")

    rc, _, _ = git(dir, "rev-parse", "--git-dir")
    if rc != 0:
        e(f"{RED}FAIL{RESET} not a git repo")
        set_status(name, "FAIL (not a repo)")
        return None

    set_head(dir, git_q(dir, "rev-parse", "HEAD"))

    e("fetching origin")
    rc, _, err = git(dir, "fetch", "--quiet")
    if rc != 0:
        e(f"{RED}FAIL{RESET} fetch failed")
        if err.strip():
            e(err.strip())
        set_status(name, "FAIL (fetch)")
        return None

    upstream = git_q(dir, "rev-parse", "--abbrev-ref",
                     "--symbolic-full-name", "@{u}")
    if not upstream:
        e(f"{YELLOW}WARN{RESET} no upstream branch; skipping pull/push")
        set_status(name, "SKIP (no upstream)")
        return None

    behind = git_q(dir, "rev-list", "--count", "HEAD..@{u}") or "0"
    ahead = git_q(dir, "rev-list", "--count", "@{u}..HEAD") or "0"
    e(f"upstream={upstream}  behind={behind}  ahead={ahead}")

    if int(behind) > 0:
        if dry_run:
            e(f"{DIM}dry-run:{RESET} git pull --ff-only --autostash --quiet")
        else:
            e("pulling updates")
            rc, _, err = git(dir, "pull", "--ff-only", "--autostash", "--quiet")
            if rc != 0:
                e(f"{RED}FAIL{RESET} pull (not fast-forward?); leaving dir alone")
                if err.strip():
                    e(err.strip())
                set_status(name, "FAIL (pull)")
                return None

    porcelain = git_q(dir, "status", "--porcelain")
    if porcelain:
        e(f"{YELLOW}DIRTY{RESET} uncommitted changes; will prompt after parallel phase")
        for line in porcelain.splitlines():
            e(line)
        set_status(name, "DIRTY (pending prompt)")
        return dir  # defer push decision

    if int(ahead) > 0:
        if dry_run:
            e(f"{DIM}dry-run:{RESET} git push --quiet")
        else:
            e("pushing local commits")
            rc, _, err = git(dir, "push", "--quiet")
            if rc != 0:
                e(f"{RED}FAIL{RESET} push failed")
                if err.strip():
                    e(err.strip())
                set_status(name, "FAIL (push)")
                return None

    e(f"{GREEN}OK{RESET}")
    set_status(name, "OK")
    return None


def repo_job(dir: Path, color: str, width: int, dry_run: bool) -> Optional[Path]:
    name = dir.name
    if dir in OPTIONAL_REPOS:
        reason = ""
        if not dir.is_dir():
            reason = "dir missing"
        elif not (dir / ".git").exists() or git(dir, "rev-parse", "--git-dir")[0] != 0:
            reason = "not a git repo"
        elif not git_q(dir, "remote"):
            reason = "no remote"
        if reason:
            emit(name, color, width, f"{YELLOW}SKIP{RESET} {reason}")
            set_status(name, f"SKIP ({reason})")
            return None
    was_missing = not dir.is_dir()
    if was_missing:
        emit(name, color, width,
             f"{YELLOW}MISSING{RESET} not on disk; cloning from GitHub")
        if not clone_missing(dir, color, width, dry_run):
            emit(name, color, width, f"{RED}FAIL{RESET} clone failed")
            set_status(name, "FAIL (clone)")
            return None
        if dry_run:
            set_status(name, "CLONE (dry-run)")
            return None
        emit(name, color, width, f"{GREEN}CLONED{RESET}")
    result = process_repo(dir, color, width, dry_run)
    if was_missing:
        # Ensure installable repositories are installed after their first clone.
        set_head(dir, "new clone")
    return result


def prompt_yn(prompt: str, default: bool = False) -> bool:
    suffix = " [Y/n] " if default else " [y/N] "
    while True:
        try:
            ans = input(prompt + suffix).strip().lower()
        except EOFError:
            return default
        if not ans:
            return default
        if ans in ("y", "yes"):
            return True
        if ans in ("n", "no"):
            return False


def clean_commit_msg(msg: str) -> str:
    msg = msg.strip()
    if msg.startswith("```"):
        lines = msg.splitlines()
        lines = lines[1:]
        if lines and lines[-1].startswith("```"):
            lines = lines[:-1]
        msg = "\n".join(lines).strip()
    return msg


def generator_failed(provider: str, reason: str, detail: str = "") -> None:
    sys.stderr.write(f"{YELLOW}{provider} {reason}{RESET}\n")
    detail = detail.strip()
    if detail:
        sys.stderr.write(detail + "\n")
    sys.stderr.flush()


def validate_commit_message(provider: str, msg: str) -> str:
    msg = clean_commit_msg(msg)
    if not msg:
        generator_failed(provider, "returned an empty commit message")
        return ""
    if not CONVENTIONAL_SUBJECT_RE.match(msg.splitlines()[0]):
        generator_failed(
            provider,
            "returned an invalid commit message; ignoring it",
            msg,
        )
        return ""
    return msg


def generate_with_claude(diff: str) -> str:
    if shutil.which("claude") is None:
        generator_failed("claude", "is not installed")
        return ""
    sys.stdout.write(f"{DIM}trying claude -p...{RESET}\n")
    sys.stdout.flush()
    try:
        proc = subprocess.run(
            ["claude", "-p", COMMIT_MESSAGE_PROMPT],
            input=diff, capture_output=True, text=True, timeout=120,
        )
    except subprocess.TimeoutExpired:
        generator_failed("claude", "timed out")
        return ""
    except OSError as err:
        generator_failed("claude", "could not be started", str(err))
        return ""
    if proc.returncode != 0:
        generator_failed(
            "claude",
            f"failed with exit code {proc.returncode}",
            proc.stderr or proc.stdout,
        )
        return ""
    return validate_commit_message("claude", proc.stdout)


def generate_with_codex(dir: Path) -> str:
    if shutil.which("codex") is None:
        generator_failed("codex", "is not installed")
        return ""
    sys.stdout.write(f"{DIM}trying codex exec...{RESET}\n")
    sys.stdout.flush()
    output_path = ""
    try:
        with tempfile.NamedTemporaryFile(
            prefix="upd-codex-", suffix=".txt", delete=False,
        ) as output_file:
            output_path = output_file.name
        proc = subprocess.run(
            [
                "codex", "exec",
                "--model", "gpt-5.6-luna",
                "--config", 'model_reasoning_effort="low"',
                "--sandbox", "read-only",
                "--ephemeral",
                "--output-last-message", output_path,
                COMMIT_MESSAGE_PROMPT,
            ],
            cwd=dir, capture_output=True, text=True, timeout=120,
        )
        if proc.returncode != 0:
            generator_failed(
                "codex",
                f"failed with exit code {proc.returncode}",
                proc.stderr or proc.stdout,
            )
            return ""
        try:
            msg = Path(output_path).read_text()
        except OSError as err:
            generator_failed("codex", "output could not be read", str(err))
            return ""
        return validate_commit_message("codex", msg)
    except subprocess.TimeoutExpired:
        generator_failed("codex", "timed out")
        return ""
    except OSError as err:
        generator_failed("codex", "could not be started", str(err))
        return ""
    finally:
        if output_path:
            try:
                os.unlink(output_path)
            except OSError:
                pass


def generate_commit_message(dir: Path) -> str:
    diff_proc = subprocess.run(
        ["git", "-C", str(dir), "diff", "--cached"],
        capture_output=True, text=True,
    )
    if diff_proc.returncode != 0:
        generator_failed(
            "git diff",
            f"failed with exit code {diff_proc.returncode}",
            diff_proc.stderr,
        )
        return ""
    diff = diff_proc.stdout
    if not diff.strip():
        generator_failed("git diff", "returned no staged changes")
        return ""
    return generate_with_claude(diff) or generate_with_codex(dir)


def handle_dirty_repos(dirty: list[Path], dry_run: bool) -> list[Path]:
    """Run the commit editor serially for each dirty repo. Return the list of
    dirs that were successfully committed (and thus need a push attempt).
    Aborting the editor (:cq) leaves the repo dirty."""
    committed: list[Path] = []
    for dir in dirty:
        name = dir.name
        sys.stdout.write(f"\n{BOLD}=== {name} is dirty ==={RESET}\n")
        _, status_out, _ = git(dir, "status", "--short")
        sys.stdout.write(status_out)
        sys.stdout.flush()

        if dry_run:
            sys.stdout.write(
                f"{DIM}dry-run:{RESET} would stage, generate msg, open editor\n"
            )
            set_status(name, "DIRTY (dry-run)")
            continue

        rc, _, err = git(dir, "add", "-A")
        if rc != 0:
            emit(name, RED, 0, f"git add failed: {err}")
            set_status(name, "FAIL (git add)")
            continue

        sys.stdout.write(f"{DIM}generating commit message...{RESET}\n")
        sys.stdout.flush()
        msg = generate_commit_message(dir)
        if not msg:
            sys.stderr.write(
                f"{YELLOW}no generated message; opening the editor with a "
                f"blank commit message{RESET}\n"
            )
            sys.stderr.flush()

        commit_cmd = ["git", "-C", str(dir), "commit", "-e"]
        msgfile: Optional[str] = None
        if msg:
            with tempfile.NamedTemporaryFile(
                "w", prefix="upd-msg-", suffix=".txt", delete=False,
            ) as f:
                f.write(msg + "\n")
                msgfile = f.name
            commit_cmd += ["-F", msgfile]

        try:
            rc = subprocess.call(commit_cmd)
        finally:
            if msgfile:
                try:
                    os.unlink(msgfile)
                except OSError:
                    pass

        if rc == 0:
            sys.stdout.write(f"{GREEN}committed{RESET} {name}\n")
            set_status(name, "COMMITTED")
            committed.append(dir)
        else:
            sys.stdout.write(
                f"{YELLOW}commit aborted; leaving {name} dirty{RESET}\n"
            )
            set_status(name, "DIRTY (commit aborted)")
    return committed


def push_after_commit(dir: Path, color: str, width: int,
                      dry_run: bool) -> None:
    name = dir.name

    def e(s: str) -> None:
        emit(name, color, width, s)

    ahead = git_q(dir, "rev-list", "--count", "@{u}..HEAD") or "0"
    if int(ahead) <= 0:
        e(f"{GREEN}OK{RESET} (nothing to push)")
        set_status(name, "OK")
        return
    if dry_run:
        e(f"{DIM}dry-run:{RESET} git push --quiet")
        return
    e("pushing local commits")
    rc, _, err = git(dir, "push", "--quiet")
    if rc != 0:
        e(f"{RED}FAIL{RESET} push failed")
        if err.strip():
            e(err.strip())
        set_status(name, "FAIL (push)")
        return
    e(f"{GREEN}OK{RESET}")
    set_status(name, "OK")


def sync_password_store(color: str, width: int, dry_run: bool) -> None:
    name = "password-store"

    def e(s: str) -> None:
        emit(name, color, width, s)

    if shutil.which("pass") is None:
        e(f"{YELLOW}SKIP{RESET} pass is not installed")
        set_status(name, "SKIP (pass missing)")
        return

    store_dir = Path(
        os.environ.get("PASSWORD_STORE_DIR", str(HOME / ".password-store"))
    ).expanduser()
    if not (store_dir / ".git").exists():
        e(f"{YELLOW}SKIP{RESET} {store_dir} is not a git repo")
        set_status(name, "SKIP (not a git repo)")
        return

    if dry_run:
        e(f"{DIM}dry-run:{RESET} pass git pull --ff-only")
        e(f"{DIM}dry-run:{RESET} pass git push")
        set_status(name, "OK")
        return

    try:
        rc = stream(name, color, width, ["pass", "git", "pull", "--ff-only"])
    except OSError as err:
        e(f"{YELLOW}WARN{RESET} could not run pull: {err}")
        set_status(name, "WARN (pull)")
        return
    if rc != 0:
        e(f"{YELLOW}WARN{RESET} pull failed; skipping push")
        set_status(name, "WARN (pull)")
        return

    try:
        rc = stream(name, color, width, ["pass", "git", "push"])
    except OSError as err:
        e(f"{YELLOW}WARN{RESET} could not run push: {err}")
        set_status(name, "WARN (push)")
        return
    if rc != 0:
        e(f"{YELLOW}WARN{RESET} push failed")
        set_status(name, "WARN (push)")
        return

    e(f"{GREEN}OK{RESET}")
    set_status(name, "OK")


def changed(dir: Path) -> bool:
    before = get_head(dir)
    if not before:
        return False
    after = git_q(dir, "rev-parse", "HEAD")
    return before != after


def install_job(dir: Path, cmd: list[str], color: str,
                width: int, dry_run: bool, force: bool) -> None:
    name = dir.name
    label = f"install:{name}"

    def e(s: str) -> None:
        emit(label, color, width, s)

    if not dir.is_dir():
        e("directory missing")
        set_status(label, "SKIP (dir missing)")
        return
    if not force and not changed(dir):
        e("HEAD unchanged")
        set_status(label, "SKIP (unchanged)")
        return
    if dry_run:
        e(f"{DIM}dry-run:{RESET} (cd {dir} && {' '.join(cmd)})")
        set_status(label, "SKIP (dry-run)")
        return
    e("running " + " ".join(cmd))
    rc = stream(label, color, width, cmd, cwd=dir)
    if rc == 0:
        e(f"installed {name}")
        set_status(label, "OK")
    else:
        e(f"{RED}FAIL{RESET} install {name}")
        set_status(label, f"FAIL (install, exit {rc})")


def self_update_and_reexec(argv: list[str]) -> None:
    """If dotfiles upstream has a newer version of this script, fast-forward
    pull and re-exec. Returns without re-execing when no update is needed,
    when dotfiles is dirty, or when any check fails."""
    dir = DOTFILES_DIR
    if not dir.is_dir():
        return
    if git(dir, "rev-parse", "--git-dir")[0] != 0:
        return
    if git(dir, "fetch", "--quiet")[0] != 0:
        return
    upstream = git_q(dir, "rev-parse", "--abbrev-ref",
                     "--symbolic-full-name", "@{u}")
    if not upstream:
        return
    behind = git_q(dir, "rev-list", "--count", "HEAD..@{u}") or "0"
    if int(behind) <= 0:
        return
    rc, out, _ = git(dir, "diff", "--name-only", "HEAD..@{u}",
                     "--", SELF_REL_PATH)
    if rc != 0 or not out.strip():
        return  # upd itself didn't change

    sys.stdout.write(
        f"{CYAN}upd: dotfiles upstream has a newer upd; pulling...{RESET}\n"
    )
    sys.stdout.flush()

    if git_q(dir, "status", "--porcelain"):
        sys.stdout.write(
            f"{YELLOW}dotfiles is dirty; skipping self-update{RESET}\n"
        )
        return
    rc, _, err = git(dir, "pull", "--ff-only", "--quiet")
    if rc != 0:
        sys.stdout.write(
            f"{YELLOW}self-update pull failed: {err.strip()}{RESET}\n"
        )
        return

    new_path = str(dir / SELF_REL_PATH)
    sys.stdout.write(f"{CYAN}restarting: {new_path}{RESET}\n")
    sys.stdout.flush()
    os.execv(new_path, [new_path, "--skip-self-update", *argv])


def summary_color(val: str) -> tuple[str, bool]:
    if val in ("OK", "COMMITTED"):
        return GREEN, False
    if val.startswith(("DIRTY", "SKIP", "CLONE", "WARN")):
        return YELLOW, False
    if val.startswith("FAIL"):
        return RED, True
    return RESET, False


def main() -> int:
    p = argparse.ArgumentParser(
        prog="upd",
        description="Update local checkouts and rebuild installables.",
    )
    p.add_argument("-n", "--dry-run", action="store_true",
                   help="show what would happen without pulling/pushing/installing")
    p.add_argument("-f", "--force", action="store_true",
                   help="force install on all projects regardless of HEAD changes")
    p.add_argument("--plain", action="store_true",
                   help="disable animated progress (automatic when output is redirected)")
    p.add_argument("--skip-self-update", action="store_true",
                   help=argparse.SUPPRESS)
    p.add_argument("filter", nargs="?", default="",
                   help="substring; only repos whose path contains it are "
                        "updated and installed")
    args = p.parse_args()
    global _plain, BOLD, RED, GREEN, YELLOW, CYAN, DIM, RESET, PREFIX_COLORS
    _plain = args.plain
    if not sys.stdout.isatty() or os.environ.get("TERM") == "dumb" or "NO_COLOR" in os.environ or _plain:
        BOLD = RED = GREEN = YELLOW = CYAN = DIM = RESET = ""
        PREFIX_COLORS = [""]

    if not args.skip_self_update:
        # Forward all args except --skip-self-update so the re-exec'd run
        # behaves identically (filter, --dry-run, --force).
        forward = [a for a in sys.argv[1:] if a != "--skip-self-update"]
        self_update_and_reexec(forward)

    selected_dirs = [d for d in REPOS if not args.filter or args.filter in str(d)]

    # Prefix width over the full configured list (so it stays stable across runs).
    width = 0
    for d, cmd in REPOS.items():
        width = max(width, len(d.name))
        if cmd:
            width = max(width, len(f"install:{d.name}"))

    # Interactive editors run between live displays with the cursor restored.
    dirty: list[Path] = []
    if selected_dirs:
        with Progress("Repositories", [d.name for d in selected_dirs]):
            with ThreadPoolExecutor(max_workers=len(selected_dirs)) as ex:
                futures = [ex.submit(run_job, d.name, repo_job, d,
                                     PREFIX_COLORS[i % len(PREFIX_COLORS)], width, args.dry_run)
                           for i, d in enumerate(selected_dirs)]
                for fut in as_completed(futures):
                    res = fut.result()
                    if res is not None:
                        dirty.append(res)

    if dirty:
        order = {d: i for i, d in enumerate(selected_dirs)}
        dirty.sort(key=lambda d: order[d])
        committed = handle_dirty_repos(dirty, args.dry_run)
        if committed:
            with Progress("Publishing commits", [d.name for d in committed]):
                with ThreadPoolExecutor(max_workers=len(committed)) as ex:
                    futures = [ex.submit(run_job, d.name, push_after_commit, d,
                                         CYAN, width, args.dry_run) for d in committed]
                    for fut in as_completed(futures):
                        fut.result()

    with Progress("Password store", ["password-store"]):
        run_job("password-store", sync_password_store, CYAN, width, args.dry_run)

    def tree_sitter_job():
        name = "install:tree-sitter-cli"
        emit(name, CYAN, width, "cargo install tree-sitter-cli")
        if args.dry_run:
            set_status(name, "SKIP (dry-run)")
        else:
            rc = stream(name, CYAN, width, ["cargo", "install", "tree-sitter-cli"])
            set_status(name, "OK" if rc == 0 else f"FAIL (exit {rc})")

    # Preserve the existing ordering of tree-sitter before project installs.
    with Progress("Tree-sitter CLI", ["install:tree-sitter-cli"]):
        run_job("install:tree-sitter-cli", tree_sitter_job)

    installs = [(d, cmd) for d in selected_dirs if (cmd := REPOS[d])]
    if installs:
        with Progress("Installations", [f"install:{d.name}" for d, _ in installs]):
            with ThreadPoolExecutor(max_workers=len(installs)) as ex:
                futures = [ex.submit(run_job, f"install:{d.name}", install_job,
                                     d, cmd, CYAN, width, args.dry_run, args.force)
                           for d, cmd in installs]
                for fut in as_completed(futures):
                    fut.result()

    return failure_summary()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
